// Prisma schema — the single source of truth for the database.
// Models are added in Tasks 1.2 (User, UserStats) and 1.3 (Course, Module,
// Lesson, Enrollment, progress). This task (1.1) establishes the connection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & progress ──────────────────────────────────────────────────
// A user's stable identity lives on User. Their frequently-updated, derived
// progress counters live in a separate 1:1 UserStats row, so the identity
// record stays lean and we don't churn it on every XP change. Auth fields
// (password hash, refresh tokens) are added in Phase 3.

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         Role     @default(USER)
  // argon2id hash of the password. Nullable: a user may sign up via OAuth later
  // (Phase 3+) and never set a local password.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stats         UserStats?
  enrollments   Enrollment[]
  completions   LessonCompletion[]
  quizScores    QuizScore[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // sha256 of the opaque refresh token — we store the hash, never the token itself.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime? // set on rotation/logout (Phase 3.4)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserStats {
  // Shares User's primary key — the hallmark of a 1:1 relation.
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXP        Int       @default(0)
  streak         Int       @default(0)
  lastActiveDate DateTime?
  currentModule  String?
  currentLesson  String?
  updatedAt      DateTime  @updatedAt
}

// ─── Course catalog ───────────────────────────────────────────────────────
// Structure (Course → Module → Lesson) is normalized so we can query, order,
// and paginate it. Each Lesson's actual teaching content is a flexible JSONB
// `blocks` array (headings, paragraphs, code, callouts…), so authoring new
// content shapes never requires a schema migration. Per-user progress
// (enrollment, completions, quiz scores) references these by id.

enum Level {
  beginner
  intermediate
  senior
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String?
  color       String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  enrollments Enrollment[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@unique([courseId, slug]) // slug unique within a course
  @@index([courseId])
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  level       Level    @default(beginner)
  duration    String?
  xp          Int      @default(0)
  description String?
  blocks      Json // structured content blocks (JSONB)
  quiz        Json? // array of quiz questions (JSONB)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  completions LessonCompletion[]
  quizScores  QuizScore[]

  @@unique([moduleId, slug])
  @@index([moduleId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId]) // a user enrolls in a course at most once
  @@index([courseId])
}

model LessonCompletion {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([userId, lessonId]) // composite PK => completed once, idempotent upsert
  @@index([lessonId])
}

model QuizScore {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  bestScore Int
  attempts  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@id([userId, lessonId])
  @@index([lessonId])
}
