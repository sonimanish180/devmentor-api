// Prisma schema — the single source of truth for the database.
// Models are added in Tasks 1.2 (User, UserStats) and 1.3 (Course, Module,
// Lesson, Enrollment, progress). This task (1.1) establishes the connection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & progress ──────────────────────────────────────────────────
// A user's stable identity lives on User. Their frequently-updated, derived
// progress counters live in a separate 1:1 UserStats row, so the identity
// record stays lean and we don't churn it on every XP change. Auth fields
// (password hash, refresh tokens) are added in Phase 3.

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         Role     @default(USER)
  // argon2id hash of the password. Nullable: a user may sign up via OAuth later
  // (Phase 3+) and never set a local password.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stats         UserStats?
  enrollments   Enrollment[]
  completions   LessonCompletion[]
  quizScores    QuizScore[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  quizAttempts  QuizAttempt[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // sha256 of the opaque refresh token — we store the hash, never the token itself.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime? // set on rotation/logout (Phase 3.4)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserStats {
  // Shares User's primary key — the hallmark of a 1:1 relation.
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXP        Int       @default(0)
  streak         Int       @default(0)
  lastActiveDate DateTime?
  currentModule  String?
  currentLesson  String?
  updatedAt      DateTime  @updatedAt
}

// ─── Course catalog ───────────────────────────────────────────────────────
// Structure (Course → Module → Lesson) is normalized so we can query, order,
// and paginate it. Each Lesson's actual teaching content is a flexible JSONB
// `blocks` array (headings, paragraphs, code, callouts…), so authoring new
// content shapes never requires a schema migration. Per-user progress
// (enrollment, completions, quiz scores) references these by id.

enum Level {
  beginner
  intermediate
  senior
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String?
  color       String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  enrollments Enrollment[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@unique([courseId, slug]) // slug unique within a course
  @@index([courseId])
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  level       Level    @default(beginner)
  duration    String?
  xp          Int      @default(0)
  description String?
  blocks      Json // structured content blocks (JSONB)
  quiz        Json? // array of quiz questions (JSONB)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  completions LessonCompletion[]
  quizScores  QuizScore[]
  timedQuiz   Quiz?

  @@unique([moduleId, slug])
  @@index([moduleId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId]) // a user enrolls in a course at most once
  @@index([courseId])
}

model LessonCompletion {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([userId, lessonId]) // composite PK => completed once, idempotent upsert
  @@index([lessonId])
}

model QuizScore {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  bestScore Int
  attempts  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@id([userId, lessonId])
  @@index([lessonId])
}

// ─── Event-driven backbone (transactional outbox) ────────────────────────
// A row here is written in the SAME database transaction as the business
// change it describes (e.g. a LessonCompletion insert). That's what makes
// this an "outbox": we never call out to Redis/BullMQ from inside the
// request path just to announce something happened — we just add one more
// row to the transaction we were already committing. A separate relay
// process (Task 7.3) polls undispatched rows and publishes them to a queue,
// so the write and the "tell everyone" step can never disagree (no dual
// write). `dispatchedAt` is null until the relay has handed it to BullMQ;
// the index supports the relay's "give me the oldest undispatched batch"
// poll query.
model OutboxEvent {
  id           String    @id @default(cuid())
  type         String // e.g. "LessonCompleted" — see src/events/contracts.ts
  payload      Json
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([dispatchedAt, createdAt])
}

// ─── Notifications (ports & adapters) ─────────────────────────────────────
// `Notification` is the durable, in-app record — always written, regardless
// of which other channels (email, realtime/WebSocket) also fire. Those other
// channels are ADAPTERS behind one `Notifier` port (src/notifications/); this
// table's shape doesn't change when a new channel is added. `type` mirrors
// the domain event that caused it (e.g. "LessonCompleted"), so the client can
// render different notification kinds without a schema change.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json? // extra structured payload for the client, e.g. { lessonId, xp }
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt]) // history, newest first
  @@index([userId, readAt]) // unread-count / bell badge
}

// Per-user channel toggles (Task 8.4). One row per user; a missing row means
// "use the defaults" (see src/notifications/preferences.ts) so shipping this
// model needs no backfill migration for existing users.
model NotificationPreference {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppEnabled    Boolean  @default(true)
  realtimeEnabled Boolean  @default(true)
  emailEnabled    Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// ─── Timed quizzes (Phase 9) ───────────────────────────────────────────────
// `QuizScore` (Phase 1) tracks a simple best-score, idempotently — fine for
// the untimed, embedded quizzes already in lesson content. A TIMED,
// stateful assessment needs more: a server-set deadline, a state machine
// (in progress -> submitted | expired), and concurrency control on that
// transition — hence a genuinely new pair of models rather than stretching
// QuizScore to cover both jobs.
model Quiz {
  id              String   @id @default(cuid())
  lessonId        String   @unique
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  durationSeconds Int
  // Question bank INCLUDING correct answers — server-side only. The API layer
  // must strip correct answers before returning a quiz to start an attempt;
  // only `submitAttempt` (server-side) ever reads them to score.
  questions       Json
  // Opt-in per quiz: submissions feed a live Redis leaderboard (Task 9.5).
  contestMode     Boolean  @default(false)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attempts QuizAttempt[]
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model QuizAttempt {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status    QuizAttemptStatus @default(IN_PROGRESS)
  startedAt DateTime          @default(now())
  // Computed by the SERVER at start time (startedAt + quiz.durationSeconds).
  // Submission is checked against this, never against a client-reported
  // "time remaining" — see ADR-0010.
  deadlineAt  DateTime
  submittedAt DateTime?
  score       Int?
  answers     Json?
  // OCC guard (src/lib/occ.ts, Task 5.2): a double-submit race can flip
  // status from IN_PROGRESS exactly once.
  version   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, quizId, status]) // "does this user already have an active attempt on this quiz"
  @@index([status, deadlineAt]) // the sweeper's poll query (Task 9.4)
}
